{
    "meta": {
        "name": "Bat Origin Pack",
        "id": "bat_origin_pack",
        "meta": "Bat Origin Pack",
        "version": "1.0.0",
        "pack_format": 15
    },
    "origin_layers/": {
        "origins:origin": {
            "origins": [
                "0:bat"
            ],
            "enabled": true
        }
    },
    "origins/": {
        "bat": {
            "name": "Bat",
            "description": "Bats. What more could you ask for?",
            "powers": [
                "0:flight",
                "0:vulnerable",
                "0:nightvision",
                "0:exhaustion"
            ],
            "icon": {
                "item": "minecraft:bat_spawn_egg"
            },
            "impact": 3
        }
    },
    "powers/": {
        "flight": {
            "name": "Flight",
            "description": "Grants Elytra flight. Press space to launch yourself upwards",
            "type": "origins:multiple",
            "elytra_flight": {
                "type": "origins:elytra_flight",
                "render_elytra": true
            },
            "flap_wings": {
                "type": "origins:launch",
                "cooldown": 20,
                "speed": 1,
                "hud_render": {
                    "should_render": true,
                    "sprite_location": "origins:textures/gui/resource_bar.png",
                    "bar_index": 4
                },
                "sound": "minecraft:entity.bat.takeoff",
                "key": {
                    "key": "key.origins.primary_active"
                }
            }
        },
        "nightvision": {
            "name": "Night Vision",
            "description": "Bats use echolocation, but you can't. You're mostly a bat, but not quite. Have fun seeing in the dark instead",
            "type": "origins:night_vision",
            "strength": 0.2
        },
        "vulnerable": {
            "name": "Small",
            "description": "Bats are small and vulnerable (well, most of them...), as such you are 40% the size of a human and have half as much health.",
            "type": "origins:multiple",
            "vulnerable": {
                "type": "origins:attribute",
                "modifier": {
                    "attribute": "minecraft:generic.max_health",
                    "operation": "multiply_base",
                    "value": -0.5,
                    "name": "Max health decrease"
                },
                "update_health": true
            },
            "small": {
                "type": "origins:action_on_callback",
                "entity_action_chosen": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:execute_command",
                            "command": "scale set pehkui:height 0.4 @s"
                        },
                        {
                            "type": "origins:execute_command",
                            "command": "scale set pehkui:width 0.4 @s"
                        },
                        {
                            "type": "origins:execute_command",
                            "command": "scale persist set true @s"
                        }
                    ]
                },
                "execute_chosen_when_orb": true,
                "entity_action_lost": {
                    "type": "origins:execute_command",
                    "command": "scale reset @s"
                }
            }
        },
        "exhaustion": {
            "name": "Exhaustion",
            "description": "Flying takes energy, especially when your're small!! Flying reduces your hunger at an increased rate.",
            "condition": {
                "type": "origins:power_active",
                "power": "*:flight"
            },
            "type": "origins:exhaust",
            "interval": 20,
            "exhaustion": 0.812
        }
    },
    "tags/": {
        "blocks/": {},
        "entity_types/": {},
        "fluids/": {},
        "functions/": {},
        "items/": {}
    },
    "functions/": {},
    "predicates/": {},
    "recipes/": {},
    "loot_tables/": {},
    "advancements/": {},
    "item_modifiers/": {},
    "assets/": {
        "lang/": {},
        "textures/": {}
    }
}